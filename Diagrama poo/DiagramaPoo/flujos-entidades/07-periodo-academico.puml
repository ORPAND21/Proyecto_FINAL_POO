@startuml
' ============================================================
' Flujo de PeriodoAcademico
' 19 clases, 18 relaciones estructurales dibujadas
' 11 dependencias de metodo conservadas comentadas al final
' Recorte del UML completo sin Matricula: mismas clases, miembros y
' relaciones del flujo. Las dependencias <<use>> no se dibujan para
' evitar cruces; se conservan comentadas al final, como en el
' diagrama depurado sin Matricula.
' Direccion: top to bottom, enrutado ortogonal.
' Nota: las relaciones ConfiguracionModuloX --> colaborador se escriben
' como colaborador <-- ConfiguracionModuloX (misma relacion y mismo
' sentido dibujado) para ordenar la capa de configuracion y reducir cruces.
' ============================================================
hide circle
hide empty members
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam classFontSize 11
skinparam classAttributeFontSize 9
skinparam classAttributeIconSize 0
skinparam classRoundCorner 0
skinparam shadowing false
skinparam monochrome false
skinparam classBorderColor black
skinparam backgroundColor white
skinparam classBackgroundColor white
' --- Paleta de colores pastel para Java 17 ---
skinparam interfaceBackgroundColor #D5F5E3
skinparam interface<<Interface>>BackgroundColor #D5F5E3
skinparam class<<Interface>>BackgroundColor #D5F5E3
skinparam abstractBackgroundColor #FFE5CC
skinparam class<<Abstract>>BackgroundColor #FFE5CC
skinparam class<<Record>>BackgroundColor #D0E1FD
' --- Paquetes ---
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
' --- Flechas y separacion ---
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 8
skinparam ArrowThickness 0.9
skinparam nodesep 22
skinparam ranksep 75
top to bottom direction
skinparam linetype ortho
title Flujo de PeriodoAcademico

package edu.unimag.vista.web {
    class PeriodoAcademicoWeb {
    -  {readOnly} controlador : PeriodoAcademicoControlador
    +  PeriodoAcademicoWeb(controlador : PeriodoAcademicoControlador) : void <<Create>>
    #  atender(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
    -  coleccion(ex : HttpExchange, metodo : String) : void
    -  cambiarEstado(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
}
    abstract class ManejadorWeb <<Abstract>> {
    -  {static, readOnly} ORIGENES_PERMITIDOS : Set<String> = Set.of("http://127.0.0.1:5500", "http://localhost:5500")
    -  {readOnly} rutaBase : String
    #  ManejadorWeb(rutaBase : String) : void <<Create>>
    +  getRutaBase() : String
    #  {abstract} atender(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
    +  {final} handle(ex : HttpExchange) : void
    #  responderJson(ex : HttpExchange, codigo : int, cuerpo : Object) : void
    #  error(mensaje : String) : String
    #  metodoNoPermitido(ex : HttpExchange, permitidos : String) : void
    #  exigirMetodo(ex : HttpExchange, metodo : String, esperado : String) : boolean
    #  noEncontrado(ex : HttpExchange) : void
    #  leerCuerpo(ex : HttpExchange) : Map<String, String>
    #  leerConsulta(ex : HttpExchange) : Map<String, String>
    #  {static} aLong(valor : String, campo : String) : Long
    #  {static} aInteger(valor : String, campo : String) : Integer
    #  {static} aUuid(valor : String, campo : String) : UUID
    #  {static} textoOpcional(campos : Map<String, String>, clave : String) : String
    #  {static} integerOpcional(campos : Map<String, String>, clave : String) : Integer
    #  {static} longOpcional(campos : Map<String, String>, clave : String) : Long
    #  {static} enumDesdeCodigo(tipo : Class<E>, valor : String, campo : String) : E
    #  {static} enumOpcional(tipo : Class<E>, campos : Map<String, String>, clave : String) : E
    #  {static} aFecha(valor : String, campo : String) : OffsetDateTime
    #  {static} fechaOpcional(campos : Map<String, String>, clave : String) : OffsetDateTime
    -  {static} requerido(valor : String, campo : String) : String
    -  aplicarCors(ex : HttpExchange) : void
    -  segmentosDeRuta(ex : HttpExchange) : List<String>
}
}

package edu.unimag.controlador {
    class PeriodoAcademicoControlador {
    -  {readOnly} servicio : PeriodoAcademicoServicio
    +  PeriodoAcademicoControlador(servicio : PeriodoAcademicoServicio) : void <<Create>>
    +  registrar(request : PeriodoAcademicoCrearDto) : PeriodoAcademicoDto
    +  listarTodos() : List<PeriodoAcademicoDto>
    +  actualizar(request : PeriodoAcademicoActualizarDto) : PeriodoAcademicoDto
    +  suspender(id : Integer) : PeriodoAcademicoDto
    +  reactivar(id : Integer) : PeriodoAcademicoDto
}
}

package edu.unimag.servicio {
    class PeriodoAcademicoServicio {
    -  {readOnly} repositorio : PeriodoAcademicoRepositorio
    -  {readOnly} mapper : PeriodoAcademicoMapeador
    +  PeriodoAcademicoServicio(repositorio : PeriodoAcademicoRepositorio, mapper : PeriodoAcademicoMapeador) : void <<Create>>
    +  registrar(dto : PeriodoAcademicoCrearDto) : PeriodoAcademicoDto
    +  listarTodos() : List<PeriodoAcademicoDto>
    +  actualizar(dto : PeriodoAcademicoActualizarDto) : PeriodoAcademicoDto
    +  suspender(id : Integer) : PeriodoAcademicoDto
    +  reactivar(id : Integer) : PeriodoAcademicoDto
}
}

package edu.unimag.mapeador {
    class PeriodoAcademicoMapeador {
    +  PeriodoAcademicoMapeador() : void <<Create>>
    +  toDto(entidad : PeriodoAcademico) : PeriodoAcademicoDto
    +  toDtoList(entidades : List<PeriodoAcademico>) : List<PeriodoAcademicoDto>
}
}

package edu.unimag.mapeador.api {
    interface Mapeador<E, R> <<Interface>> {
    +  {abstract} toDto(entidad : E) : R
    +  {abstract} toDtoList(entidades : List<E>) : List<R>
}
}

package edu.unimag.repositorio.cargador {
    class PeriodoAcademicoCargador {
    -  {readOnly} repositorio : PeriodoAcademicoRepositorio
    -  {readOnly} cache : Map<Integer, PeriodoAcademico>
    +  PeriodoAcademicoCargador(repositorio : PeriodoAcademicoRepositorio) : void <<Create>>
    +  cargarTodos() : void
    +  cargarPorIds(ids : List<Integer>) : void
    +  registrarEnCache(entidad : PeriodoAcademico) : void
    +  obtener(id : Integer) : Optional<PeriodoAcademico>
    +  existe(id : Integer) : boolean
}
}

package edu.unimag.repositorio {
    interface PeriodoAcademicoRepositorio <<Interface>> {
    +  {abstract} insertarSiNombreNoExiste(nombre : String, periodo : PeriodoAcademico) : boolean
    +  {abstract} actualizarNombreSiNoExisteEnOtra(idPeriodoAcademico : Integer, nuevoNombre : String) : boolean
}
}

package edu.unimag.repositorio.api {
    interface CargadorDatos<T, ID> <<Interface>> {
    +  {abstract} cargarTodos() : void
    +  {abstract} cargarPorIds(ids : List<ID>) : void
    +  {abstract} registrarEnCache(entidad : T) : void
    +  {abstract} obtener(id : ID) : Optional<T>
    +  {abstract} existe(id : ID) : boolean
}
    interface RepositorioBase<T, ID> <<Interface>> {
    +  {abstract} guardar(entidad : T) : T
    +  {abstract} actualizar(entidad : T) : T
    +  {abstract} buscarPorId(id : ID) : Optional<T>
    +  {abstract} eliminar(id : ID) : boolean
    +  {abstract} listarTodos() : List<T>
    +  {abstract} contar() : long
    +  {abstract} cerrar() : void
}
}

package edu.unimag.persistencia {
    class PeriodoAcademicoRepositorioImpl {
    +  PeriodoAcademicoRepositorioImpl(tpaRepository : TpaRepository<PeriodoAcademico, Integer>) : void <<Create>>
    +  insertarSiNombreNoExiste(nombre : String, periodo : PeriodoAcademico) : boolean
    +  actualizarNombreSiNoExisteEnOtra(idPeriodoAcademico : Integer, nuevoNombre : String) : boolean
}
}

package edu.unimag.persistencia.abstracta {
    abstract class RepositorioBaseAbstracto<T, ID> <<Abstract>> {
    #  {readOnly} tpaRepository : TpaRepository<T, ID>
    +  RepositorioBaseAbstracto(tpaRepository : TpaRepository<T, ID>) : void <<Create>>
    +  guardar(entidad : T) : T
    +  actualizar(entidad : T) : T
    +  buscarPorId(id : ID) : Optional<T>
    +  listarTodos() : List<T>
    +  contar() : long
    +  {final} eliminar(id : ID) : boolean
    +  cerrar() : void
    #  permiteBorradoFisico() : boolean
}
}

package edu.unimag.dto.periodoacademico {
    class PeriodoAcademicoCrearDto <<Record>> {
    +  {readOnly} nombre : String
}
    class PeriodoAcademicoActualizarDto <<Record>> {
    +  {readOnly} id : Integer
    +  {readOnly} nuevoNombre : String
}
    class PeriodoAcademicoDto <<Record>> {
    +  {readOnly} id : Integer
    +  {readOnly} nombre : String
    +  {readOnly} estado : EstadoEntidad
}
}

package edu.unimag.modelo {
    class PeriodoAcademico {
    -  idPeriodoAcademico : Integer
    -  nombrePeriodoAcademico : String
    -  estadoPeriodoAcademico : EstadoEntidad
    #  PeriodoAcademico() : void <<Create>>
    +  PeriodoAcademico(nombrePeriodoAcademico : String) : void <<Create>>
    +  PeriodoAcademico(idPeriodoAcademico : Integer, nombrePeriodoAcademico : String, estadoPeriodoAcademico : EstadoEntidad) : void <<Create>>
    +  corregirNombre(nuevoNombre : String) : void
    +  suspender() : void
    +  reactivar() : void
    +  estaActivo() : boolean
    +  getIdPeriodoAcademico() : Integer
    +  getNombrePeriodoAcademico() : String
    +  getEstadoPeriodoAcademico() : EstadoEntidad
}
}

package edu.unimag.modelo.enumeracion {
    enum EstadoEntidad {
    +  {static, readOnly} ACTIVO : EstadoEntidad
    +  {static, readOnly} INACTIVO : EstadoEntidad
    -  {readOnly} code : int
    -  {readOnly} description : String
    ~  EstadoEntidad(code : int, description : String) : void <<Create>>
    +  getCode() : int
    +  getDescription() : String
    +  cambiarEstadoA(nuevoEstado : EstadoEntidad) : EstadoEntidad
}
}

package edu.unimag.config.modulos {
    class ConfiguracionModuloPeriodoAcademico {
    -  {readOnly} periodoAcademicoRepositorio : PeriodoAcademicoRepositorio
    -  {readOnly} periodoAcademicoServicio : PeriodoAcademicoServicio
    +  ConfiguracionModuloPeriodoAcademico() : void <<Create>>
    +  getPeriodoAcademicoRepositorio() : PeriodoAcademicoRepositorio
    +  getPeriodoAcademicoServicio() : PeriodoAcademicoServicio
    +  construirControlador() : PeriodoAcademicoControlador
    +  cerrarRecursos() : void
}
}

package edu.unimag.config.modulos.api {
    interface ModuloConfigurable <<Interface>> {
    +  {abstract} cerrarRecursos() : void
}
}

' --- Orden de capas (oculto) ---
edu.unimag.vista.web.PeriodoAcademicoWeb -[hidden]-> edu.unimag.controlador.PeriodoAcademicoControlador
edu.unimag.controlador.PeriodoAcademicoControlador -[hidden]-> edu.unimag.servicio.PeriodoAcademicoServicio
edu.unimag.servicio.PeriodoAcademicoServicio -[hidden]-> edu.unimag.mapeador.PeriodoAcademicoMapeador
edu.unimag.servicio.PeriodoAcademicoServicio -[hidden]-> edu.unimag.repositorio.PeriodoAcademicoRepositorio
edu.unimag.mapeador.PeriodoAcademicoMapeador -[hidden]-> edu.unimag.repositorio.cargador.PeriodoAcademicoCargador
edu.unimag.mapeador.PeriodoAcademicoMapeador -[hidden]-> edu.unimag.modelo.PeriodoAcademico
edu.unimag.repositorio.PeriodoAcademicoRepositorio -[hidden]-> edu.unimag.persistencia.PeriodoAcademicoRepositorioImpl
edu.unimag.repositorio.PeriodoAcademicoRepositorio -[hidden]-> edu.unimag.modelo.PeriodoAcademico
edu.unimag.persistencia.PeriodoAcademicoRepositorioImpl -[hidden]-> edu.unimag.modelo.PeriodoAcademico
edu.unimag.mapeador.PeriodoAcademicoMapeador -[hidden]-> edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico
edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico -[hidden]-> edu.unimag.repositorio.PeriodoAcademicoRepositorio

' --- Grafo de relaciones estructurales ---
edu.unimag.vista.web.ManejadorWeb <|-- edu.unimag.vista.web.PeriodoAcademicoWeb
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.PeriodoAcademicoMapeador
edu.unimag.repositorio.PeriodoAcademicoRepositorio <|.. edu.unimag.persistencia.PeriodoAcademicoRepositorioImpl
edu.unimag.repositorio.api.CargadorDatos <|.. edu.unimag.repositorio.cargador.PeriodoAcademicoCargador
edu.unimag.repositorio.api.RepositorioBase <|-- edu.unimag.repositorio.PeriodoAcademicoRepositorio
edu.unimag.repositorio.api.RepositorioBase <|.. edu.unimag.persistencia.abstracta.RepositorioBaseAbstracto
edu.unimag.persistencia.abstracta.RepositorioBaseAbstracto <|-- edu.unimag.persistencia.PeriodoAcademicoRepositorioImpl
edu.unimag.config.modulos.api.ModuloConfigurable <|.. edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico
edu.unimag.vista.web.PeriodoAcademicoWeb "1" --> "1" edu.unimag.controlador.PeriodoAcademicoControlador
edu.unimag.controlador.PeriodoAcademicoControlador "1" --> "1" edu.unimag.servicio.PeriodoAcademicoServicio
edu.unimag.servicio.PeriodoAcademicoServicio "1" --> "1" edu.unimag.mapeador.PeriodoAcademicoMapeador
edu.unimag.servicio.PeriodoAcademicoServicio "1" --> "1" edu.unimag.repositorio.PeriodoAcademicoRepositorio
edu.unimag.repositorio.cargador.PeriodoAcademicoCargador "1" --> "1" edu.unimag.repositorio.PeriodoAcademicoRepositorio
edu.unimag.repositorio.cargador.PeriodoAcademicoCargador "1" o-- "*" edu.unimag.modelo.PeriodoAcademico
edu.unimag.dto.periodoacademico.PeriodoAcademicoDto "1" --> "1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.modelo.PeriodoAcademico "1" --> "1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico "1" *-- "1" edu.unimag.servicio.PeriodoAcademicoServicio
edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico "1" *-- "1" edu.unimag.repositorio.PeriodoAcademicoRepositorio

