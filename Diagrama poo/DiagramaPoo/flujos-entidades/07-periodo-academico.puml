' edu.unimag.controlador.PeriodoAcademicoControlador ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoCrearDto : <<use>>
' edu.unimag.controlador.PeriodoAcademicoControlador ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoDto : <<use>>
' edu.unimag.servicio.PeriodoAcademicoServicio ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoActualizarDto : <<use>>
' edu.unimag.servicio.PeriodoAcademicoServicio ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoCrearDto : <<use>>
' edu.unimag.servicio.PeriodoAcademicoServicio ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoDto : <<use>>
' edu.unimag.mapeador.PeriodoAcademicoMapeador ..> edu.unimag.dto.periodoacademico.PeriodoAcademicoDto : <<use>>
' edu.unimag.mapeador.PeriodoAcademicoMapeador ..> edu.unimag.modelo.PeriodoAcademico : <<use>>
' edu.unimag.repositorio.PeriodoAcademicoRepositorio ..> edu.unimag.modelo.PeriodoAcademico : <<use>>
' edu.unimag.persistencia.PeriodoAcademicoRepositorioImpl ..> edu.unimag.modelo.PeriodoAcademico : <<use>>
' edu.unimag.config.modulos.ConfiguracionModuloPeriodoAcademico ..> edu.unimag.controlador.PeriodoAcademicoControlador : <<use>>

@enduml
