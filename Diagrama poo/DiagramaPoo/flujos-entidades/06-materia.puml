@startuml
' ============================================================
' Flujo de Materia
' 19 clases, 18 relaciones estructurales dibujadas
' 9 dependencias de metodo conservadas comentadas al final
' Recorte del UML completo sin Matricula: mismas clases, miembros y
' relaciones del flujo. Las dependencias <<use>> no se dibujan para
' evitar cruces; se conservan comentadas al final, como en el
' diagrama depurado sin Matricula.
' Direccion: top to bottom, enrutado ortogonal.
' Nota: las relaciones ConfiguracionModuloX --> colaborador se escriben
' como colaborador <-- ConfiguracionModuloX (misma relacion y mismo
' sentido dibujado) para ordenar la capa de configuracion y reducir cruces.
' ============================================================
hide circle
hide empty members
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam classFontSize 11
skinparam classAttributeFontSize 9
skinparam classAttributeIconSize 0
skinparam classRoundCorner 0
skinparam shadowing false
skinparam monochrome false
skinparam classBorderColor black
skinparam backgroundColor white
skinparam classBackgroundColor white
' --- Paleta de colores pastel para Java 17 ---
skinparam interfaceBackgroundColor #D5F5E3
skinparam interface<<Interface>>BackgroundColor #D5F5E3
skinparam class<<Interface>>BackgroundColor #D5F5E3
skinparam abstractBackgroundColor #FFE5CC
skinparam class<<Abstract>>BackgroundColor #FFE5CC
skinparam class<<Record>>BackgroundColor #D0E1FD
' --- Paquetes ---
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
' --- Flechas y separacion ---
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 8
skinparam ArrowThickness 0.9
skinparam nodesep 22
skinparam ranksep 75
top to bottom direction
skinparam linetype ortho
title Flujo de Materia

package edu.unimag.vista.web {
    class MateriaWeb {
    -  {readOnly} controlador : MateriaControlador
    +  MateriaWeb(controlador : MateriaControlador) : void <<Create>>
    #  atender(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
    -  coleccion(ex : HttpExchange, metodo : String) : void
    -  cambiarEstado(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
}
    abstract class ManejadorWeb <<Abstract>> {
    -  {static, readOnly} ORIGENES_PERMITIDOS : Set<String> = Set.of("http://127.0.0.1:5500", "http://localhost:5500")
    -  {readOnly} rutaBase : String
    #  ManejadorWeb(rutaBase : String) : void <<Create>>
    +  getRutaBase() : String
    #  {abstract} atender(ex : HttpExchange, metodo : String, segmentos : List<String>) : void
    +  {final} handle(ex : HttpExchange) : void
    #  responderJson(ex : HttpExchange, codigo : int, cuerpo : Object) : void
    #  error(mensaje : String) : String
    #  metodoNoPermitido(ex : HttpExchange, permitidos : String) : void
    #  exigirMetodo(ex : HttpExchange, metodo : String, esperado : String) : boolean
    #  noEncontrado(ex : HttpExchange) : void
    #  leerCuerpo(ex : HttpExchange) : Map<String, String>
    #  leerConsulta(ex : HttpExchange) : Map<String, String>
    #  {static} aLong(valor : String, campo : String) : Long
    #  {static} aInteger(valor : String, campo : String) : Integer
    #  {static} aUuid(valor : String, campo : String) : UUID
    #  {static} textoOpcional(campos : Map<String, String>, clave : String) : String
    #  {static} integerOpcional(campos : Map<String, String>, clave : String) : Integer
    #  {static} longOpcional(campos : Map<String, String>, clave : String) : Long
    #  {static} enumDesdeCodigo(tipo : Class<E>, valor : String, campo : String) : E
    #  {static} enumOpcional(tipo : Class<E>, campos : Map<String, String>, clave : String) : E
    #  {static} aFecha(valor : String, campo : String) : OffsetDateTime
    #  {static} fechaOpcional(campos : Map<String, String>, clave : String) : OffsetDateTime
    -  {static} requerido(valor : String, campo : String) : String
    -  aplicarCors(ex : HttpExchange) : void
    -  segmentosDeRuta(ex : HttpExchange) : List<String>
}
}

package edu.unimag.controlador {
    class MateriaControlador {
    -  {readOnly} servicio : MateriaServicio
    +  MateriaControlador(servicio : MateriaServicio) : void <<Create>>
    +  registrar(request : MateriaCrearDto) : MateriaDto
    +  listarTodas() : List<MateriaDto>
    +  actualizar(request : MateriaActualizarDto) : MateriaDto
    +  suspender(id : Integer) : MateriaDto
    +  reactivar(id : Integer) : MateriaDto
}
}

package edu.unimag.servicio {
    class MateriaServicio {
    -  {readOnly} repositorio : MateriaRepositorio
    -  {readOnly} mapper : MateriaMapeador
    +  MateriaServicio(repositorio : MateriaRepositorio, mapper : MateriaMapeador) : void <<Create>>
    +  registrarMateria(dto : MateriaCrearDto) : MateriaDto
    +  listarTodas() : List<MateriaDto>
    +  actualizar(dto : MateriaActualizarDto) : MateriaDto
    +  suspender(id : Integer) : MateriaDto
    +  reactivar(id : Integer) : MateriaDto
    +  buscarPorId(id : Integer) : MateriaDto
}
}

package edu.unimag.mapeador {
    class MateriaMapeador {
    +  MateriaMapeador() : void <<Create>>
    +  toDto(entidad : Materia) : MateriaDto
    +  toDtoList(entidades : List<Materia>) : List<MateriaDto>
}
}

package edu.unimag.mapeador.api {
    interface Mapeador<E, R> <<Interface>> {
    +  {abstract} toDto(entidad : E) : R
    +  {abstract} toDtoList(entidades : List<E>) : List<R>
}
}

package edu.unimag.repositorio.cargador {
    class MateriaCargador {
    -  {readOnly} repositorio : MateriaRepositorio
    -  {readOnly} cache : Map<Integer, Materia>
    +  MateriaCargador(repositorio : MateriaRepositorio) : void <<Create>>
    +  cargarTodos() : void
    +  cargarPorIds(ids : List<Integer>) : void
    +  registrarEnCache(entidad : Materia) : void
    +  obtener(id : Integer) : Optional<Materia>
    +  existe(id : Integer) : boolean
}
}

package edu.unimag.repositorio {
    interface MateriaRepositorio <<Interface>> {
}
}

package edu.unimag.repositorio.api {
    interface CargadorDatos<T, ID> <<Interface>> {
    +  {abstract} cargarTodos() : void
    +  {abstract} cargarPorIds(ids : List<ID>) : void
    +  {abstract} registrarEnCache(entidad : T) : void
    +  {abstract} obtener(id : ID) : Optional<T>
    +  {abstract} existe(id : ID) : boolean
}
    interface RepositorioBase<T, ID> <<Interface>> {
    +  {abstract} guardar(entidad : T) : T
    +  {abstract} actualizar(entidad : T) : T
    +  {abstract} buscarPorId(id : ID) : Optional<T>
    +  {abstract} eliminar(id : ID) : boolean
    +  {abstract} listarTodos() : List<T>
    +  {abstract} contar() : long
    +  {abstract} cerrar() : void
}
}

package edu.unimag.persistencia {
    class MateriaRepositorioImpl {
    +  MateriaRepositorioImpl(tpaRepository : TpaRepository<Materia, Integer>) : void <<Create>>
}
}

package edu.unimag.persistencia.abstracta {
    abstract class RepositorioBaseAbstracto<T, ID> <<Abstract>> {
    #  {readOnly} tpaRepository : TpaRepository<T, ID>
    +  RepositorioBaseAbstracto(tpaRepository : TpaRepository<T, ID>) : void <<Create>>
    +  guardar(entidad : T) : T
    +  actualizar(entidad : T) : T
    +  buscarPorId(id : ID) : Optional<T>
    +  listarTodos() : List<T>
    +  contar() : long
    +  {final} eliminar(id : ID) : boolean
    +  cerrar() : void
    #  permiteBorradoFisico() : boolean
}
}

package edu.unimag.dto.materia {
    class MateriaCrearDto <<Record>> {
    +  {readOnly} nombre : String
    +  {readOnly} creditos : Integer
    +  {readOnly} cupoMaximo : Integer
}
    class MateriaActualizarDto <<Record>> {
    +  {readOnly} id : Integer
    +  {readOnly} nuevoNombre : String
    +  {readOnly} nuevosCreditos : Integer
    +  {readOnly} nuevoCupo : Integer
}
    class MateriaDto <<Record>> {
    +  {readOnly} id : Integer
    +  {readOnly} nombre : String
    +  {readOnly} creditos : Integer
    +  {readOnly} cupoMaximo : Integer
    +  {readOnly} estado : EstadoEntidad
}
}

package edu.unimag.modelo {
    class Materia {
    -  idMateria : Integer
    -  nombreMateria : String
    -  creditosMateria : Integer
    -  cupoMaximoMateria : Integer
    -  estadoMateria : EstadoEntidad
    #  Materia() : void <<Create>>
    +  Materia(nombreMateria : String, creditosMateria : Integer, cupoMaximoMateria : Integer) : void <<Create>>
    +  Materia(idMateria : Integer, nombreMateria : String, creditosMateria : Integer, cupoMaximoMateria : Integer, estadoMateria : EstadoEntidad) : void <<Create>>
    +  actualizarNombre(nuevoNombre : String) : void
    +  actualizarCupo(nuevoCupo : Integer) : void
    +  actualizarCreditos(nuevosCreditos : Integer) : void
    +  suspender() : void
    +  reactivar() : void
    +  estaActiva() : boolean
    +  getIdMateria() : Integer
    +  getNombreMateria() : String
    +  getCreditosMateria() : Integer
    +  getCupoMaximoMateria() : Integer
    +  getEstadoMateria() : EstadoEntidad
}
}

package edu.unimag.modelo.enumeracion {
    enum EstadoEntidad {
    +  {static, readOnly} ACTIVO : EstadoEntidad
    +  {static, readOnly} INACTIVO : EstadoEntidad
    -  {readOnly} code : int
    -  {readOnly} description : String
    ~  EstadoEntidad(code : int, description : String) : void <<Create>>
    +  getCode() : int
    +  getDescription() : String
    +  cambiarEstadoA(nuevoEstado : EstadoEntidad) : EstadoEntidad
}
}

package edu.unimag.config.modulos {
    class ConfiguracionModuloMateria {
    -  {readOnly} materiaRepositorio : MateriaRepositorio
    -  {readOnly} materiaServicio : MateriaServicio
    +  ConfiguracionModuloMateria() : void <<Create>>
    +  getMateriaRepositorio() : MateriaRepositorio
    +  getMateriaServicio() : MateriaServicio
    +  construirControlador() : MateriaControlador
    +  cerrarRecursos() : void
}
}

package edu.unimag.config.modulos.api {
    interface ModuloConfigurable <<Interface>> {
    +  {abstract} cerrarRecursos() : void
}
}

' --- Orden de capas (oculto) ---
edu.unimag.vista.web.MateriaWeb -[hidden]-> edu.unimag.controlador.MateriaControlador
edu.unimag.controlador.MateriaControlador -[hidden]-> edu.unimag.servicio.MateriaServicio
edu.unimag.servicio.MateriaServicio -[hidden]-> edu.unimag.mapeador.MateriaMapeador
edu.unimag.servicio.MateriaServicio -[hidden]-> edu.unimag.repositorio.MateriaRepositorio
edu.unimag.mapeador.MateriaMapeador -[hidden]-> edu.unimag.repositorio.cargador.MateriaCargador
edu.unimag.mapeador.MateriaMapeador -[hidden]-> edu.unimag.modelo.Materia
edu.unimag.repositorio.MateriaRepositorio -[hidden]-> edu.unimag.persistencia.MateriaRepositorioImpl
edu.unimag.repositorio.MateriaRepositorio -[hidden]-> edu.unimag.modelo.Materia
edu.unimag.persistencia.MateriaRepositorioImpl -[hidden]-> edu.unimag.modelo.Materia
edu.unimag.mapeador.MateriaMapeador -[hidden]-> edu.unimag.config.modulos.ConfiguracionModuloMateria
edu.unimag.config.modulos.ConfiguracionModuloMateria -[hidden]-> edu.unimag.repositorio.MateriaRepositorio

' --- Grafo de relaciones estructurales ---
edu.unimag.vista.web.ManejadorWeb <|-- edu.unimag.vista.web.MateriaWeb
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.MateriaMapeador
edu.unimag.repositorio.MateriaRepositorio <|.. edu.unimag.persistencia.MateriaRepositorioImpl
edu.unimag.repositorio.api.CargadorDatos <|.. edu.unimag.repositorio.cargador.MateriaCargador
edu.unimag.repositorio.api.RepositorioBase <|-- edu.unimag.repositorio.MateriaRepositorio
edu.unimag.repositorio.api.RepositorioBase <|.. edu.unimag.persistencia.abstracta.RepositorioBaseAbstracto
edu.unimag.persistencia.abstracta.RepositorioBaseAbstracto <|-- edu.unimag.persistencia.MateriaRepositorioImpl
edu.unimag.config.modulos.api.ModuloConfigurable <|.. edu.unimag.config.modulos.ConfiguracionModuloMateria
edu.unimag.vista.web.MateriaWeb "1" --> "1" edu.unimag.controlador.MateriaControlador
edu.unimag.controlador.MateriaControlador "1" --> "1" edu.unimag.servicio.MateriaServicio
edu.unimag.servicio.MateriaServicio "1" --> "1" edu.unimag.mapeador.MateriaMapeador
edu.unimag.servicio.MateriaServicio "1" --> "1" edu.unimag.repositorio.MateriaRepositorio
edu.unimag.repositorio.cargador.MateriaCargador "1" --> "1" edu.unimag.repositorio.MateriaRepositorio
edu.unimag.repositorio.cargador.MateriaCargador "1" o-- "*" edu.unimag.modelo.Materia
edu.unimag.dto.materia.MateriaDto "1" --> "1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.modelo.Materia "1" --> "1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.config.modulos.ConfiguracionModuloMateria "1" *-- "1" edu.unimag.servicio.MateriaServicio
edu.unimag.config.modulos.ConfiguracionModuloMateria "1" *-- "1" edu.unimag.repositorio.MateriaRepositorio

' --- Dependencias de metodo (conservadas como en el UML completo) ---
' edu.unimag.controlador.MateriaControlador ..> edu.unimag.dto.materia.MateriaActualizarDto : <<use>>
' edu.unimag.controlador.MateriaControlador ..> edu.unimag.dto.materia.MateriaCrearDto : <<use>>
' edu.unimag.controlador.MateriaControlador ..> edu.unimag.dto.materia.MateriaDto : <<use>>
' edu.unimag.servicio.MateriaServicio ..> edu.unimag.dto.materia.MateriaActualizarDto : <<use>>
' edu.unimag.servicio.MateriaServicio ..> edu.unimag.dto.materia.MateriaCrearDto : <<use>>
' edu.unimag.servicio.MateriaServicio ..> edu.unimag.dto.materia.MateriaDto : <<use>>
' edu.unimag.mapeador.MateriaMapeador ..> edu.unimag.dto.materia.MateriaDto : <<use>>
' edu.unimag.mapeador.MateriaMapeador ..> edu.unimag.modelo.Materia : <<use>>
' edu.unimag.config.modulos.ConfiguracionModuloMateria ..> edu.unimag.controlador.MateriaControlador : <<use>>

@enduml
