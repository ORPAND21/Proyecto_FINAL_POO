@startuml
' Panel 10 - Asociaciones DTO -> modelo. Config: left to right, ortho, nodesep 8, ranksep 80.
' --- Sin iconos de PlantUML: el tipo lo indican las palabras clave ---
hide circle
skinparam classAttributeIconSize 0
set separator none
' Compartimentos vacios suprimidos (UML 2.5.1 permite no mostrarlos)
hide empty members
' Clases externas de Java: no se analizan por dentro (compartimentos ocultos, no vacios)
hide <<JDK-External>> members
' --- Tipografia y lineas ---
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
left to right direction
skinparam linetype ortho
skinparam nodesep 8
skinparam ranksep 80
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor white
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.1
' --- Clases: encabezado con banda gris, nombre en negrita ---
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #F4F6F7
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam stereotypeFontSize 10
skinparam stereotypeFontColor #566573
' --- Paquetes (carpeta, como en UML) ---
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
' --- Paleta pastel por tipo de clasificador ---
skinparam class<<interface>>BackgroundColor #E8F8F0
skinparam class<<interface>>HeaderBackgroundColor #D5F5E3
skinparam interfaceBackgroundColor #E8F8F0
skinparam interfaceHeaderBackgroundColor #D5F5E3
skinparam class<<enumeration>>BackgroundColor #FEF9E7
skinparam class<<enumeration>>HeaderBackgroundColor #FCF3CF
skinparam class<<annotation>>BackgroundColor #F5EEF8
skinparam class<<annotation>>HeaderBackgroundColor #EBDEF0
skinparam class<<record>>BackgroundColor #EBF5FB
skinparam class<<record>>HeaderBackgroundColor #D6EAF8
skinparam class<<JDK-External>>BackgroundColor #F2F3F4
skinparam class<<JDK-External>>BorderColor #AAB7B8
skinparam interface<<JDK-External>>BackgroundColor #F2F3F4
skinparam interface<<JDK-External>>BorderColor #AAB7B8

' --- Definicion de Clasificadores (Agrupados por Paquete) ---
skinparam groupInheritance 2

' --- Paquetes ordenados por capa ---
package edu.unimag {
    class "CursoProfesorActualizarDto" as edu.unimag.dto.cursoProfesor.CursoProfesorActualizarDto <<record>> {
    +  idCursoPeriodo : UUID {readOnly}
    +  idProfesor : Long {readOnly}
    +  tipoAsignacion : TipoAsignacion {readOnly}
    }
    class "CursoProfesorCrearDto" as edu.unimag.dto.cursoProfesor.CursoProfesorCrearDto <<record>> {
    +  idCursoPeriodo : UUID {readOnly}
    +  idProfesor : Long {readOnly}
    +  tipoAsignacion : TipoAsignacion {readOnly}
    }
    class "CursoProfesorDto" as edu.unimag.dto.cursoProfesor.CursoProfesorDto <<record>> {
    +  profesor : ProfesorDto {readOnly}
    +  cursoPeriodoDto : CursoPeriodoDto {readOnly}
    +  tipoAsignacion : TipoAsignacion {readOnly}
    +  estadoProfesorCurso : EstadoProfesorCurso {readOnly}
    +  fechaAsignacion : OffsetDateTime {readOnly}
    }
    class "EstudianteDto" as edu.unimag.dto.estudiante.EstudianteDto <<record>> {
    +  id : UUID {readOnly}
    +  codigo : String {readOnly}
    +  nombre : String {readOnly}
    +  correo : String {readOnly}
    +  celular : String {readOnly}
    +  direccion : String {readOnly}
    +  estado : EstadoEntidad {readOnly}
    +  activo : Boolean {readOnly}
    }
    class "FacultadDto" as edu.unimag.dto.facultad.FacultadDto <<record>> {
    +  id : Long {readOnly}
    +  nombre : String {readOnly}
    +  estado : EstadoEntidad {readOnly}
    }
    class "MateriaDto" as edu.unimag.dto.materia.MateriaDto <<record>> {
    +  id : Integer {readOnly}
    +  nombre : String {readOnly}
    +  creditos : Integer {readOnly}
    +  cupoMaximo : Integer {readOnly}
    +  estado : EstadoEntidad {readOnly}
    }
    class "PeriodoAcademicoDto" as edu.unimag.dto.periodoacademico.PeriodoAcademicoDto <<record>> {
    +  id : Integer {readOnly}
    +  nombre : String {readOnly}
    +  estado : EstadoEntidad {readOnly}
    }
    class "PlanEstudioDto" as edu.unimag.dto.planestudio.PlanEstudioDto <<record>> {
    +  id : Long {readOnly}
    +  version : String {readOnly}
    +  estado : EstadoEntidad {readOnly}
    +  fechaCreacion : OffsetDateTime {readOnly}
    +  programa : ProgramaDto {readOnly}
    }
    class "ProfesorDto" as edu.unimag.dto.profesor.ProfesorDto <<record>> {
    +  id : Long {readOnly}
    +  nombre : String {readOnly}
    +  celular : String {readOnly}
    +  estado : EstadoEntidad {readOnly}
    +  activo : Boolean {readOnly}
    }
    class "ProgramaActualizarDto" as edu.unimag.dto.programa.ProgramaActualizarDto <<record>> {
    +  id : UUID {readOnly}
    +  nuevoNombre : String {readOnly}
    +  nuevoNivel : NivelPrograma {readOnly}
    +  nuevoIdFacultad : Long {readOnly}
    }
    class "ProgramaCrearDto" as edu.unimag.dto.programa.ProgramaCrearDto <<record>> {
    +  nombre : String {readOnly}
    +  nivelPrograma : NivelPrograma {readOnly}
    +  idFacultad : Long {readOnly}
    }
    class "ProgramaDto" as edu.unimag.dto.programa.ProgramaDto <<record>> {
    +  id : UUID {readOnly}
    +  nombre : String {readOnly}
    +  nivelPrograma : NivelPrograma {readOnly}
    +  facultad : FacultadDto {readOnly}
    +  estado : EstadoEntidad {readOnly}
    }
    enum "EstadoEntidad" as edu.unimag.modelo.enumeracion.EstadoEntidad <<enumeration>> {
    ACTIVO
    INACTIVO
    --
    -  code : int {readOnly}
    -  description : String {readOnly}
    --
    -  <<create>> EstadoEntidad(code : int, description : String)
    +  getCode() : int
    +  getDescription() : String
    +  cambiarEstadoA(nuevoEstado : EstadoEntidad) : EstadoEntidad
    }
    enum "EstadoProfesorCurso" as edu.unimag.modelo.enumeracion.EstadoProfesorCurso <<enumeration>> {
    ACTIVO
    RETIRADO
    --
    -  code : int {readOnly}
    -  description : String {readOnly}
    --
    -  <<create>> EstadoProfesorCurso(code : int, description : String)
    +  getCode() : int
    +  getDescription() : String
    +  cambiarEstado(nuevo : EstadoProfesorCurso) : EstadoProfesorCurso
    }
    enum "NivelPrograma" as edu.unimag.modelo.enumeracion.NivelPrograma <<enumeration>> {
    TECNICO
    TECNOLOGICO
    PREGRADO
    ESPECIALIZACION
    MAESTRIA
    DOCTORADO
    --
    -  code : int {readOnly}
    -  description : String {readOnly}
    --
    -  <<create>> NivelPrograma(code : int, description : String)
    +  getCode() : int
    +  getDescription() : String
    }
    enum "TipoAsignacion" as edu.unimag.modelo.enumeracion.TipoAsignacion <<enumeration>> {
    PROFESOR_PRINCIPAL
    PROFESOR_ACOMPANANTE
    AUDITOR
    --
    -  code : int {readOnly}
    -  description : String {readOnly}
    --
    -  <<create>> TipoAsignacion(code : int, description : String)
    +  getCode() : int
    +  getDescription() : String
    }
edu.unimag.dto.cursoProfesor.CursoProfesorActualizarDto --> "tipoAsignacion\n1" edu.unimag.modelo.enumeracion.TipoAsignacion
edu.unimag.dto.cursoProfesor.CursoProfesorCrearDto --> "tipoAsignacion\n1" edu.unimag.modelo.enumeracion.TipoAsignacion
edu.unimag.dto.cursoProfesor.CursoProfesorDto --> "estadoProfesorCurso\n1" edu.unimag.modelo.enumeracion.EstadoProfesorCurso
edu.unimag.dto.cursoProfesor.CursoProfesorDto --> "tipoAsignacion\n1" edu.unimag.modelo.enumeracion.TipoAsignacion
edu.unimag.dto.estudiante.EstudianteDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.facultad.FacultadDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.materia.MateriaDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.periodoacademico.PeriodoAcademicoDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.planestudio.PlanEstudioDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.profesor.ProfesorDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.programa.ProgramaDto --> "estado\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
edu.unimag.dto.programa.ProgramaActualizarDto --> "nuevoNivel\n1" edu.unimag.modelo.enumeracion.NivelPrograma
edu.unimag.dto.programa.ProgramaCrearDto --> "nivelPrograma\n1" edu.unimag.modelo.enumeracion.NivelPrograma
edu.unimag.dto.programa.ProgramaDto --> "nivelPrograma\n1" edu.unimag.modelo.enumeracion.NivelPrograma
@enduml
