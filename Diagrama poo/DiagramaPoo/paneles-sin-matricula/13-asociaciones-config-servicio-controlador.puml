    +  cerrarRecursos() : void
    }
    class "CursoProfesorControlador" as edu.unimag.controlador.CursoProfesorControlador {
    -  cursoProfesorServicio : CursoProfesorServicio {readOnly}
    -  profesorServicio : ProfesorServicio {readOnly}
    -  cursoPeriodoServicio : CursoPeriodoServicio {readOnly}
    --
    +  <<create>> CursoProfesorControlador(cursoProfesorServicio : CursoProfesorServicio, profesorServicio : ProfesorServicio, cursoPeriodoServicio : CursoPeriodoServicio)
    +  asignar(dto : CursoProfesorCrearDto) : CursoProfesorDto
