    --
    +  <<create>> FormacionProfesorControlador(servicio : FormacionProfesorServicio)
    +  registrar(request : FormacionProfesorCrearDto) : FormacionProfesorDto
    +  listarTodos() : FormacionProfesorDto [*] {ordered, nonunique}
    +  actualizar(request : FormacionProfesorActualizarDto) : FormacionProfesorDto
