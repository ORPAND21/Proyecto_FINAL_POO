    +  listarPorProfesor(idProfesor : Long) : FormacionProfesorDto [*] {ordered, nonunique}
    }
    class "CursoPeriodoServicio" as edu.unimag.servicio.CursoPeriodoServicio {
    -  cursoPeriodoRepositorio : CursoPeriodoRepositorio {readOnly}
    -  materiaRepositorio : MateriaRepositorio {readOnly}
    -  periodoAcademicoRepositorio : PeriodoAcademicoRepositorio {readOnly}
    -  mapeador : CursoPeriodoMapeador {readOnly}
    --
    +  <<create>> CursoPeriodoServicio(cursoPeriodoRepositorio : CursoPeriodoRepositorio, materiaRepositorio : MateriaRepositorio, periodoAcademicoRepositorio : PeriodoAcademicoRepositorio, mapeador : CursoPeriodoMapeador)
    +  registrar(dto : CursoPeriodoCrearDto) : CursoPeriodoDto
    +  listarTodos() : CursoPeriodoDto [*] {ordered, nonunique}
    +  actualizar(dto : CursoPeriodoActualizarDto) : CursoPeriodoDto
    +  eliminar(id : UUID) : boolean
    -  hidratarYMapearUnico(cursoPeriodo : CursoPeriodo) : CursoPeriodoDto
    +  buscarPorId(id : UUID) : CursoPeriodoDto
    }
    class "ProfesorServicio" as edu.unimag.servicio.ProfesorServicio {
    -  repositorio : ProfesorRepositorio {readOnly}
    -  mapper : ProfesorMapeador {readOnly}
    --
    +  <<create>> ProfesorServicio(repositorio : ProfesorRepositorio, mapper : ProfesorMapeador)
    +  registrarProfesor(dto : ProfesorCrearDto) : ProfesorDto
