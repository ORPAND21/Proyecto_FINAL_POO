edu.unimag.config.ConfiguracionDependenciasWeb --> "cursoProfesorControlador\n1" edu.unimag.controlador.CursoProfesorControlador
edu.unimag.config.ConfiguracionDependenciasWeb --> "facultadControlador\n1" edu.unimag.controlador.FacultadControlador
