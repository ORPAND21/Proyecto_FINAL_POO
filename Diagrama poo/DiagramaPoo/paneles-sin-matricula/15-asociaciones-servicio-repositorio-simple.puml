@startuml
' Panel 15 - Asociaciones servicio -> repositorio (servicios de una sola dependencia). Config: left to right, ortho, nodesep 8, ranksep 80.
' --- Sin iconos de PlantUML: el tipo lo indican las palabras clave ---
hide circle
skinparam classAttributeIconSize 0
set separator none
' Compartimentos vacios suprimidos (UML 2.5.1 permite no mostrarlos)
hide empty members
' Clases externas de Java: no se analizan por dentro (compartimentos ocultos, no vacios)
hide <<JDK-External>> members
' --- Tipografia y lineas ---
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
left to right direction
skinparam linetype ortho
skinparam nodesep 8
skinparam ranksep 80
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor white
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.1
' --- Clases: encabezado con banda gris, nombre en negrita ---
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #F4F6F7
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam stereotypeFontSize 10
skinparam stereotypeFontColor #566573
' --- Paquetes (carpeta, como en UML) ---
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
' --- Paleta pastel por tipo de clasificador ---
skinparam class<<interface>>BackgroundColor #E8F8F0
skinparam class<<interface>>HeaderBackgroundColor #D5F5E3
skinparam interfaceBackgroundColor #E8F8F0
skinparam interfaceHeaderBackgroundColor #D5F5E3
skinparam class<<enumeration>>BackgroundColor #FEF9E7
skinparam class<<enumeration>>HeaderBackgroundColor #FCF3CF
skinparam class<<annotation>>BackgroundColor #F5EEF8
skinparam class<<annotation>>HeaderBackgroundColor #EBDEF0
skinparam class<<record>>BackgroundColor #EBF5FB
skinparam class<<record>>HeaderBackgroundColor #D6EAF8
skinparam class<<JDK-External>>BackgroundColor #F2F3F4
skinparam class<<JDK-External>>BorderColor #AAB7B8
skinparam interface<<JDK-External>>BackgroundColor #F2F3F4
skinparam interface<<JDK-External>>BorderColor #AAB7B8

' --- Definicion de Clasificadores (Agrupados por Paquete) ---
skinparam groupInheritance 2

' --- Paquetes ordenados por capa ---
package edu.unimag {
    interface "EstudianteRepositorio" as edu.unimag.repositorio.EstudianteRepositorio <<interface>> {
    +  {abstract} insertarSiCodigoNoExiste(codigo : String, estudiante : Estudiante) : boolean
    }
    interface "FacultadRepositorio" as edu.unimag.repositorio.FacultadRepositorio <<interface>> {
    +  {abstract} insertarSiNombreNoExiste(nombre : String, facultad : Facultad) : boolean
    +  {abstract} actualizarNombreSiNoExisteEnOtra(idFacultad : Long, nuevoNombre : String) : boolean
    }
    interface "MateriaRepositorio" as edu.unimag.repositorio.MateriaRepositorio <<interface>> {
    }
    interface "PeriodoAcademicoRepositorio" as edu.unimag.repositorio.PeriodoAcademicoRepositorio <<interface>> {
    +  {abstract} insertarSiNombreNoExiste(nombre : String, periodo : PeriodoAcademico) : boolean
    +  {abstract} actualizarNombreSiNoExisteEnOtra(idPeriodoAcademico : Integer, nuevoNombre : String) : boolean
    }
    interface "ProfesorRepositorio" as edu.unimag.repositorio.ProfesorRepositorio <<interface>> {
    }
    class "EstudianteServicio" as edu.unimag.servicio.EstudianteServicio {
    -  repositorio : EstudianteRepositorio {readOnly}
    -  mapper : EstudianteMapeador {readOnly}
    --
    +  <<create>> EstudianteServicio(repositorio : EstudianteRepositorio, mapper : EstudianteMapeador)
    +  registrarNuevoEstudiante(dto : EstudianteCrearDto) : EstudianteDto
    +  actualizarDatos(dto : EstudianteActualizarDto) : EstudianteDto
    +  activar(id : UUID) : EstudianteDto
    +  inactivar(id : UUID) : EstudianteDto
    +  buscarPorId(id : UUID) : EstudianteDto
    +  listarTodos() : EstudianteDto [*] {ordered, nonunique}
    +  listarActivos() : EstudianteDto [*] {ordered, nonunique}
    +  listarInactivos() : EstudianteDto [*] {ordered, nonunique}
    +  estaActivo(id : UUID) : boolean
    +  contarEstudiantes() : int
    }
    class "FacultadServicio" as edu.unimag.servicio.FacultadServicio {
    -  repositorio : FacultadRepositorio {readOnly}
    -  mapper : FacultadMapeador {readOnly}
    --
    +  <<create>> FacultadServicio(repositorio : FacultadRepositorio, mapper : FacultadMapeador)
    +  registrarFacultad(dto : FacultadCrearDto) : FacultadDto
    +  listarTodas() : FacultadDto [*] {ordered, nonunique}
    +  actualizar(dto : FacultadActualizarDto) : FacultadDto
    +  suspender(id : Long) : FacultadDto
    +  reactivar(id : Long) : FacultadDto
    }
    class "MateriaServicio" as edu.unimag.servicio.MateriaServicio {
    -  repositorio : MateriaRepositorio {readOnly}
    -  mapper : MateriaMapeador {readOnly}
    --
    +  <<create>> MateriaServicio(repositorio : MateriaRepositorio, mapper : MateriaMapeador)
    +  registrarMateria(dto : MateriaCrearDto) : MateriaDto
    +  listarTodas() : MateriaDto [*] {ordered, nonunique}
    +  actualizar(dto : MateriaActualizarDto) : MateriaDto
    +  suspender(id : Integer) : MateriaDto
    +  reactivar(id : Integer) : MateriaDto
    +  buscarPorId(id : Integer) : MateriaDto
    }
    class "PeriodoAcademicoServicio" as edu.unimag.servicio.PeriodoAcademicoServicio {
    -  repositorio : PeriodoAcademicoRepositorio {readOnly}
    -  mapper : PeriodoAcademicoMapeador {readOnly}
    --
    +  <<create>> PeriodoAcademicoServicio(repositorio : PeriodoAcademicoRepositorio, mapper : PeriodoAcademicoMapeador)
    +  registrar(dto : PeriodoAcademicoCrearDto) : PeriodoAcademicoDto
    +  listarTodos() : PeriodoAcademicoDto [*] {ordered, nonunique}
    +  actualizar(dto : PeriodoAcademicoActualizarDto) : PeriodoAcademicoDto
    +  suspender(id : Integer) : PeriodoAcademicoDto
    +  reactivar(id : Integer) : PeriodoAcademicoDto
    }
    class "ProfesorServicio" as edu.unimag.servicio.ProfesorServicio {
    -  repositorio : ProfesorRepositorio {readOnly}
    -  mapper : ProfesorMapeador {readOnly}
    --
    +  <<create>> ProfesorServicio(repositorio : ProfesorRepositorio, mapper : ProfesorMapeador)
    +  registrarProfesor(dto : ProfesorCrearDto) : ProfesorDto
    +  actualizar(dto : ProfesorActualizarDto) : ProfesorDto
    +  buscarPorId(id : Long) : ProfesorDto
    +  listarTodos() : ProfesorDto [*] {ordered, nonunique}
    +  listarActivos() : ProfesorDto [*] {ordered, nonunique}
    +  listarInactivos() : ProfesorDto [*] {ordered, nonunique}
    +  estaActivo(id : Long) : boolean
    +  contarProfesores() : int
    }
edu.unimag.servicio.EstudianteServicio --> "repositorio\n1" edu.unimag.repositorio.EstudianteRepositorio
edu.unimag.servicio.FacultadServicio --> "repositorio\n1" edu.unimag.repositorio.FacultadRepositorio
edu.unimag.servicio.MateriaServicio --> "repositorio\n1" edu.unimag.repositorio.MateriaRepositorio
edu.unimag.servicio.PeriodoAcademicoServicio --> "repositorio\n1" edu.unimag.repositorio.PeriodoAcademicoRepositorio
edu.unimag.servicio.ProfesorServicio --> "repositorio\n1" edu.unimag.repositorio.ProfesorRepositorio
@enduml
