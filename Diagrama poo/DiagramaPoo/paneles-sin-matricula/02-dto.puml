    +  {static} limpiarUuidRequerido(valor : UUID, mensajeError : String) : UUID
    +  {static} limpiarEnteroRequerido(valor : Integer, mensajeError : String) : Integer
    +  {static} limpiarLongRequerido(valor : Long, mensajeError : String) : Long
    +  {static} limpiarCorreo(correo : String) : String
