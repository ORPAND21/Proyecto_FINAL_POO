    +  {static} limpiarEnteroPositivo(valor : Integer, mensajeError : String) : Integer
    +  {static} limpiarBigDecimalPositivo(valor : BigDecimal, mensajeError : String) : BigDecimal
    +  {static} limpiarBigDecimalNoNegativo(valor : BigDecimal, mensajeError : String) : BigDecimal
    +  {static} limpiarListaRequerida<T>(lista : T [*] {ordered, nonunique}, mensajeError : String) : T [*] {ordered, nonunique}
