@startuml
' Panel 04 - Mapeador, realizaciones. Config: top to bottom, polyline, nodesep 8, ranksep 260.
' --- Sin iconos de PlantUML: el tipo lo indican las palabras clave ---
hide circle
skinparam classAttributeIconSize 0
set separator none
' Compartimentos vacios suprimidos (UML 2.5.1 permite no mostrarlos)
hide empty members
' Clases externas de Java: no se analizan por dentro (compartimentos ocultos, no vacios)
hide <<JDK-External>> members
' --- Tipografia y lineas ---
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
top to bottom direction
skinparam linetype polyline
skinparam nodesep 8
skinparam ranksep 260
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor white
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.1
' --- Clases: encabezado con banda gris, nombre en negrita ---
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #F4F6F7
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam stereotypeFontSize 10
skinparam stereotypeFontColor #566573
' --- Paquetes (carpeta, como en UML) ---
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
' --- Paleta pastel por tipo de clasificador ---
skinparam class<<interface>>BackgroundColor #E8F8F0
skinparam class<<interface>>HeaderBackgroundColor #D5F5E3
skinparam interfaceBackgroundColor #E8F8F0
skinparam interfaceHeaderBackgroundColor #D5F5E3
skinparam class<<enumeration>>BackgroundColor #FEF9E7
skinparam class<<enumeration>>HeaderBackgroundColor #FCF3CF
skinparam class<<annotation>>BackgroundColor #F5EEF8
skinparam class<<annotation>>HeaderBackgroundColor #EBDEF0
skinparam class<<record>>BackgroundColor #EBF5FB
skinparam class<<record>>HeaderBackgroundColor #D6EAF8
skinparam class<<JDK-External>>BackgroundColor #F2F3F4
skinparam class<<JDK-External>>BorderColor #AAB7B8
skinparam interface<<JDK-External>>BackgroundColor #F2F3F4
skinparam interface<<JDK-External>>BorderColor #AAB7B8

' --- Definicion de Clasificadores (Agrupados por Paquete) ---
skinparam groupInheritance 2

' --- Paquetes ordenados por capa ---
package edu.unimag {
    class "CursoProfesorMapeador" as edu.unimag.mapeador.CursoProfesorMapeador {
    -  profesorMapeador : ProfesorMapeador {readOnly}
    -  cursoPeriodoMapeador : CursoPeriodoMapeador {readOnly}
    --
    +  <<create>> CursoProfesorMapeador(profesorMapeador : ProfesorMapeador, cursoPeriodoMapeador : CursoPeriodoMapeador)
    +  toDtoList(entidades : CursoProfesor [*] {ordered, nonunique}, profesorCargador : ProfesorCargador, cursoPeriodoCargador : CursoPeriodoCargador, materiaCargador : MateriaCargador, periodoCargador : PeriodoAcademicoCargador) : CursoProfesorDto [*] {ordered, nonunique}
    -  validarIntegridad(miEntidad : CursoProfesor, profesorCargador : ProfesorCargador, cursoPeriodoCargador : CursoPeriodoCargador, materiaCargador : MateriaCargador, periodoCargador : PeriodoAcademicoCargador) : boolean
    -  transformarDto(miEntidad : CursoProfesor, profesorCargador : ProfesorCargador, cursoPeriodoCargador : CursoPeriodoCargador, materiaCargador : MateriaCargador, periodoCargador : PeriodoAcademicoCargador) : CursoProfesorDto
    +  toDto(entidad : CursoProfesor, profesorCargador : ProfesorCargador, cursoPeriodoCargador : CursoPeriodoCargador, materiaCargador : MateriaCargador, periodoCargador : PeriodoAcademicoCargador) : CursoProfesorDto
    }
    class "EstudianteMapeador" as edu.unimag.mapeador.EstudianteMapeador {
    +  toDto(entidad : Estudiante) : EstudianteDto
    +  toDtoList(entidades : Estudiante [*] {ordered, nonunique}) : EstudianteDto [*] {ordered, nonunique}
    }
    class "FacultadMapeador" as edu.unimag.mapeador.FacultadMapeador {
    +  <<create>> FacultadMapeador()
    +  toDto(entidad : Facultad) : FacultadDto
    +  toDtoList(entidades : Facultad [*] {ordered, nonunique}) : FacultadDto [*] {ordered, nonunique}
    }
    class "FormacionProfesorMapeador" as edu.unimag.mapeador.FormacionProfesorMapeador {
    -  profesorMapeador : ProfesorMapeador {readOnly}
    --
    +  <<create>> FormacionProfesorMapeador(profesorMapeador : ProfesorMapeador)
    +  toDto(entity : FormacionProfesor, profesorCargador : ProfesorCargador) : FormacionProfesorDto
    +  toDtoList(entidades : FormacionProfesor [*] {ordered, nonunique}, profesorCargador : ProfesorCargador) : FormacionProfesorDto [*] {ordered, nonunique}
    }
    class "MateriaMapeador" as edu.unimag.mapeador.MateriaMapeador {
    +  <<create>> MateriaMapeador()
    +  toDto(entidad : Materia) : MateriaDto
    +  toDtoList(entidades : Materia [*] {ordered, nonunique}) : MateriaDto [*] {ordered, nonunique}
    }
    class "PeriodoAcademicoMapeador" as edu.unimag.mapeador.PeriodoAcademicoMapeador {
    +  <<create>> PeriodoAcademicoMapeador()
    +  toDto(entidad : PeriodoAcademico) : PeriodoAcademicoDto
    +  toDtoList(entidades : PeriodoAcademico [*] {ordered, nonunique}) : PeriodoAcademicoDto [*] {ordered, nonunique}
    }
    class "ProfesorMapeador" as edu.unimag.mapeador.ProfesorMapeador {
    +  <<create>> ProfesorMapeador()
    +  toDto(entidad : Profesor) : ProfesorDto
    +  toDtoList(entidades : Profesor [*] {ordered, nonunique}) : ProfesorDto [*] {ordered, nonunique}
    }
    interface "Mapeador" as edu.unimag.mapeador.api.Mapeador<E, R> <<interface>> {
    +  {abstract} toDto(entidad : E) : R
    +  {abstract} toDtoList(entidades : E [*] {ordered, nonunique}) : R [*] {ordered, nonunique}
    }
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.EstudianteMapeador : <E -> Estudiante, R -> EstudianteDto>
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.FacultadMapeador : <E -> Facultad, R -> FacultadDto>
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.MateriaMapeador : <E -> Materia, R -> MateriaDto>
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.PeriodoAcademicoMapeador : <E -> PeriodoAcademico, R -> PeriodoAcademicoDto>
edu.unimag.mapeador.api.Mapeador <|.. edu.unimag.mapeador.ProfesorMapeador : <E -> Profesor, R -> ProfesorDto>
@enduml
