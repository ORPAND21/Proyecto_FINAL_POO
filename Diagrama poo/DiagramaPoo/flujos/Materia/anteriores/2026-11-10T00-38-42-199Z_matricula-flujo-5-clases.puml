@startuml
' ============================================================================
' Matricula y sus cinco clases relacionadas: flujo completo por capas
' Archivo independiente: no modifica el UML canonico ni proyecto.json
' Firmas tomadas del codigo real de proyecto_clase_poo_2
' Seis flujos: Matricula, Estudiante, CursoPeriodo, Materia,
' PeriodoAcademico y Profesor; las clases compartidas van al final.
' Cada flujo recorre vista web -> controlador -> servicio ->
' mapeador / cargador -> repositorio -> implementacion -> modelo.
' ============================================================================
hide circle
skinparam classAttributeIconSize 0
set separator none
hide empty members
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
top to bottom direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor white
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.1
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #F4F6F7
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam stereotypeFontSize 10
skinparam stereotypeFontColor #566573
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
skinparam class<<interface>>BackgroundColor #E8F8F0
skinparam class<<interface>>HeaderBackgroundColor #D5F5E3
skinparam interfaceBackgroundColor #E8F8F0
skinparam interfaceHeaderBackgroundColor #D5F5E3
skinparam class<<enumeration>>BackgroundColor #FEF9E7
skinparam class<<enumeration>>HeaderBackgroundColor #FCF3CF
skinparam class<<record>>BackgroundColor #EBF5FB
skinparam class<<record>>HeaderBackgroundColor #D6EAF8

title Matricula y sus cinco clases relacionadas - flujo completo por capas

legend right
  **Lectura del diagrama**
  - Seis flujos: **Matricula** y sus cinco clases relacionadas:
    **Estudiante**, **CursoPeriodo**, **Materia**, **PeriodoAcademico**
    y **Profesor**.
  - Cada flujo recorre: vista web -> controlador -> servicio ->
    mapeador / cargador -> repositorio -> implementacion -> modelo.
  - Las cinco flechas punteadas que salen del paquete **Matricula**
    hacia los paquetes de apoyo indican que Matricula usa esas cinco
    cadenas. El detalle por capa es:
      - MatriculaControlador inyecta MatriculaServicio y los servicios
        de Estudiante, CursoPeriodo, Materia y Profesor; no inyecta
        PeriodoAcademicoServicio.
      - MatriculaServicio usa MatriculaRepositorio, MatriculaMapeador
        y los cinco repositorios de apoyo.
      - MatriculaMapeador usa los cinco mapeadores y los cinco
        cargadores, y ensambla MatriculaDto.
      - MatriculaDto contiene los cinco DTOs de salida.
      - MatriculaPk contiene las cinco claves de los modelos.
      - ConfiguracionModuloMatricula construye MatriculaControlador y
        referencia MatriculaRepositorio.
  - **Validacion de CursoPeriodo**: las flechas punteadas
    "valida materia" y "valida periodo" muestran que
    CursoPeriodoServicio consulta MateriaRepositorio y
    PeriodoAcademicoRepositorio.
  - **PK de Matricula** (en orden): Estudiante, CursoPeriodo, Materia,
    PeriodoAcademico y Profesor.
  - **Clases compartidas** (paquete Compartido):
      - ManejadorWeb: base de las vistas web.
      - RepositorioBase: interfaz base de los repositorios.
      - RepositorioBaseAbstracto: base de las implementaciones;
        realiza RepositorioBase.
      - Mapeador: interfaz de EstudianteMapeador, MateriaMapeador,
        PeriodoAcademicoMapeador y ProfesorMapeador;
        CursoPeriodoMapeador no la implementa.
      - CargadorDatos: interfaz de los cinco cargadores.
    Para no saturar el diagrama, solo se dibujan las generalizaciones
    del flujo Matricula hacia ManejadorWeb, RepositorioBase y
    RepositorioBaseAbstracto; las demas cadenas usan las mismas bases.
  - Linea continua: asociacion o composicion. Linea punteada:
    dependencia de uso. Triangulo punteado: realizacion.
  - Solo vistas web; no se incluyen vistas de consola.
endlegend


' ============================================================================
' Matricula
' ============================================================================
package "Matricula" as PMAT {
    class "MatriculaWeb" as edu.unimag.vista.web.MatriculaWeb {
      -  controlador : MatriculaControlador
      --
      +  <<create>> MatriculaWeb(...)
      #  atender(...) : void
      -  coleccion(...) : void
    }

    class "MatriculaControlador" as edu.unimag.controlador.MatriculaControlador {
      -  matriculaServicio : MatriculaServicio
      -  estudianteServicio : EstudianteServicio
      -  cursoPeriodoServicio : CursoPeriodoServicio
      --
      +  <<create>> MatriculaControlador(...)
      +  matricular(...) : MatriculaDto
      +  retirar(...) : MatriculaDto
    }

    class "MatriculaServicio" as edu.unimag.servicio.MatriculaServicio {
      -  matriculaRepositorio : MatriculaRepositorio
      -  estudianteRepositorio : EstudianteRepositorio
      -  cursoPeriodoRepositorio : CursoPeriodoRepositorio
      --
      +  <<create>> MatriculaServicio(...)
      +  matricular(...) : MatriculaDto
      +  retirar(...) : MatriculaDto
    }

    class "MatriculaMapeador" as edu.unimag.mapeador.MatriculaMapeador {
      -  estudianteMapeador : EstudianteMapeador
      -  cursoPeriodoMapeador : CursoPeriodoMapeador
      -  materiaMapeador : MateriaMapeador
      --
      +  <<create>> MatriculaMapeador(...)
      +  toDto(...) : MatriculaDto
      +  toDtoList(...) : MatriculaDto [*]
    }

    interface "MatriculaRepositorio" as edu.unimag.repositorio.MatriculaRepositorio <<interface>> {
      +  {abstract} insertarSiNoExiste(...) : boolean
      +  {abstract} listarPorEstudiante(...) : Matricula [*]
      +  {abstract} listarPorCursoPeriodo(...) : Matricula [*]
    }

    class "MatriculaRepositorioImpl" as edu.unimag.persistencia.MatriculaRepositorioImpl {
      +  <<create>> MatriculaRepositorioImpl(...)
      +  insertarSiNoExiste(...) : boolean
      +  listarPorEstudiante(...) : Matricula [*]
    }

    class "MatriculaDto" as edu.unimag.dto.matricula.MatriculaDto <<record>> {
      +  estudiante : EstudianteDto
      +  cursoPeriodo : CursoPeriodoDto
      +  materia : MateriaDto
    }

    class "MatriculaCrearDto" as edu.unimag.dto.matricula.MatriculaCrearDto <<record>> {
      +  idEstudiante : UUID
      +  idCursoPeriodo : UUID
      +  idMateria : Integer
    }

    class "Matricula" as edu.unimag.modelo.Matricula {
      -  idMatricula : MatriculaPk
      -  fechaMatricula : OffsetDateTime
      -  estadoMatricula : EstadoEntidad
      --
      #  <<create>> Matricula(...)
      +  <<create>> Matricula(...)
      +  retirar(...) : void
    }

    class "MatriculaPk" as edu.unimag.modelo.pk.MatriculaPk {
      -  estudiante : Estudiante
      -  cursoPeriodo : CursoPeriodo
      -  materia : Materia
      --
      +  <<create>> MatriculaPk(...)
      +  getEstudiante(...) : Estudiante
      +  getCursoPeriodo(...) : CursoPeriodo
    }

    class "ConfiguracionModuloMatricula" as edu.unimag.config.modulos.ConfiguracionModuloMatricula {
      -  matriculaRepositorio : MatriculaRepositorio
      -  estudianteRepositorio : EstudianteRepositorio
      -  cursoPeriodoRepositorio : CursoPeriodoRepositorio
      --
      +  <<create>> ConfiguracionModuloMatricula(...)
      +  construirControlador(...) : MatriculaControlador
      +  cerrarRecursos(...) : void
    }

    interface "ModuloConfigurable" as edu.unimag.config.modulos.api.ModuloConfigurable <<interface>> {
      +  {abstract} cerrarRecursos(...) : void
    }

    enum "EstadoEntidad" as edu.unimag.modelo.enumeracion.EstadoEntidad <<enumeration>> {
      ACTIVO
      INACTIVO
      --
      -  code : int
      -  description : String
      --
      +  getCode(...) : int
      +  getDescription(...) : String
      +  cambiarEstadoA(...) : EstadoEntidad
    }

    edu.unimag.vista.web.MatriculaWeb --> "controlador\n1" edu.unimag.controlador.MatriculaControlador
    edu.unimag.controlador.MatriculaControlador --> "matriculaServicio\n1" edu.unimag.servicio.MatriculaServicio
    edu.unimag.controlador.MatriculaControlador ..> "entrada\n1" edu.unimag.dto.matricula.MatriculaCrearDto
    edu.unimag.servicio.MatriculaServicio --> "mapeador\n1" edu.unimag.mapeador.MatriculaMapeador
    edu.unimag.servicio.MatriculaServicio --> "matriculaRepositorio\n1" edu.unimag.repositorio.MatriculaRepositorio
    edu.unimag.mapeador.MatriculaMapeador --> "produce\n1" edu.unimag.dto.matricula.MatriculaDto
    edu.unimag.mapeador.MatriculaMapeador ..> "lee\n1" edu.unimag.modelo.Matricula
    edu.unimag.repositorio.MatriculaRepositorio --> "entrega\n1" edu.unimag.modelo.Matricula
    edu.unimag.repositorio.MatriculaRepositorio <|.. edu.unimag.persistencia.MatriculaRepositorioImpl
    edu.unimag.persistencia.MatriculaRepositorioImpl ..> "persiste\n1" edu.unimag.modelo.Matricula
    edu.unimag.modelo.Matricula *--> "idMatricula\n1" edu.unimag.modelo.pk.MatriculaPk
    edu.unimag.modelo.Matricula --> "estadoMatricula\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
    edu.unimag.dto.matricula.MatriculaDto --> "estadoMatricula\n1" edu.unimag.modelo.enumeracion.EstadoEntidad
    edu.unimag.config.modulos.api.ModuloConfigurable <|.. edu.unimag.config.modulos.ConfiguracionModuloMatricula
    edu.unimag.config.modulos.ConfiguracionModuloMatricula *--> "matriculaRepositorio\n1" edu.unimag.repositorio.MatriculaRepositorio
    edu.unimag.config.modulos.ConfiguracionModuloMatricula ..> "construye\n1" edu.unimag.controlador.MatriculaControlador
}


