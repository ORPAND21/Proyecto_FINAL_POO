@startuml
' ============================================================================
' Rebanada enfocada en Matricula (PK compuesta de cinco modelos)
' Archivo independiente: no modifica el UML canonico ni proyecto.json
' Firmas tomadas del codigo real de proyecto_clase_poo_2
' Los cinco cargadores, mapeadores y repositorios de apoyo se resumen en
' notas para mantener el foco en la cadena principal de Matricula.
' ============================================================================
hide circle
skinparam classAttributeIconSize 0
set separator none
hide empty members
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
left to right direction
skinparam linetype ortho
skinparam nodesep 18
skinparam ranksep 80
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor white
skinparam ArrowColor #34495E
skinparam ArrowFontColor #34495E
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.1
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 1
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #F4F6F7
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam stereotypeFontSize 10
skinparam stereotypeFontColor #566573
skinparam packageStyle folder
skinparam packageBorderColor #85929E
skinparam packageBackgroundColor #FBFCFC
skinparam packageFontColor #2C3E50
skinparam packageFontStyle bold
skinparam class<<interface>>BackgroundColor #E8F8F0
skinparam class<<interface>>HeaderBackgroundColor #D5F5E3
skinparam interfaceBackgroundColor #E8F8F0
skinparam interfaceHeaderBackgroundColor #D5F5E3
skinparam class<<enumeration>>BackgroundColor #FEF9E7
skinparam class<<enumeration>>HeaderBackgroundColor #FCF3CF
skinparam class<<record>>BackgroundColor #EBF5FB
skinparam class<<record>>HeaderBackgroundColor #D6EAF8
skinparam class<<resumen>>BackgroundColor #FBFCFC
skinparam class<<resumen>>HeaderBackgroundColor #F2F3F4
skinparam class<<resumen>>BorderColor #AAB7B8

title Matricula - rebanada de clases (PK compuesta de cinco modelos)

legend right
  **Alcance de esta rebanada**
  - Cadena principal: MatriculaWeb -> MatriculaControlador ->
    MatriculaServicio -> MatriculaMapeador / MatriculaRepositorio ->
    Matricula + MatriculaPk -> cinco modelos.
  - Salida: MatriculaDto con los cinco DTOs + fecha + estado.
  - Entrada: MatriculaCrearDto con los cinco IDs de la PK.
  - Los cinco cargadores, mapeadores y repositorios de apoyo
    se resumen en notas; sus clases individuales estan en el
    UML canonico completo.
endlegend

' ============================================================================
' Vista web
' ============================================================================
abstract class "ManejadorWeb {abstract}" as ManejadorWeb #FDEBD0 {
-  {static} {field} ORIGENES_PERMITIDOS : String [*] =\n   Set.of("http://127.0.0.1:5500", "http://... {readOnly}
-  rutaBase : String {readOnly}
--
#  <<create>> ManejadorWeb(rutaBase : String)
+  getRutaBase() : String
#  {abstract} atender(ex : HttpExchange, metodo : String,\n   segmentos : String [*] {ordered, nonunique}) : void
+  handle(ex : HttpExchange) : void
#  responderJson(ex : HttpExchange, codigo : int, cuerpo : Object) : void
#  error(mensaje : String) : String
#  metodoNoPermitido(ex : HttpExchange, permitidos : String) : void
#  noEncontrado(ex : HttpExchange) : void
#  leerCuerpo(ex : HttpExchange) : Map<String, String>
#  leerConsulta(ex : HttpExchange) : Map<String, String>
#  {static} aLong(valor : String, campo : String) : Long
#  {static} aInteger(valor : String, campo : String) : Integer
#  {static} aUuid(valor : String, campo : String) : UUID
}

note bottom of ManejadorWeb
  Base comun de las vistas web: CORS, JSON,
  lectura de cuerpo/consulta y conversion de tipos.
  El detalle completo esta en el UML canonico.
end note

class "MatriculaWeb" as MatriculaWeb {
-  controlador : MatriculaControlador {readOnly}
--
+  <<create>> MatriculaWeb(controlador : MatriculaControlador)
#  atender(ex : HttpExchange, metodo : String,\n   segmentos : String [*] {ordered, nonunique}) : void
-  coleccion(ex : HttpExchange, metodo : String) : void
-  listar(ex : HttpExchange) : void
-  matricular(ex : HttpExchange) : void
-  accionSobreMatricula(ex : HttpExchange, metodo : String,\n   segmentos : String [*] {ordered, nonunique}) : void
}

note bottom of MatriculaWeb
  GET  /api/matriculas?idEstudiante=...
  GET  /api/matriculas?idCursoPeriodo=...
  POST /api/matriculas
  PUT  .../{idEstudiante}/{idCursoPeriodo}/{idMateria}/
       {idPeriodoAcademico}/{idProfesor}/retirar|reactivar
end note

' ============================================================================
' Controlador y servicio
' ============================================================================
class "MatriculaControlador" as MatriculaControlador {
-  matriculaServicio : MatriculaServicio {readOnly}
-  estudianteServicio : EstudianteServicio {readOnly}
-  cursoPeriodoServicio : CursoPeriodoServicio {readOnly}
-  materiaServicio : MateriaServicio {readOnly}
-  profesorServicio : ProfesorServicio {readOnly}
--
+  <<create>> MatriculaControlador(\n   matriculaServicio : MatriculaServicio,\n   estudianteServicio : EstudianteServicio,\n   cursoPeriodoServicio : CursoPeriodoServicio,\n   materiaServicio : MateriaServicio,\n   profesorServicio : ProfesorServicio)
+  matricular(dto : MatriculaCrearDto) : MatriculaDto
+  retirar(\n   idEstudiante : UUID,\n   idCursoPeriodo : UUID,\n   idMateria : Integer,\n   idPeriodoAcademico : Integer,\n   idProfesor : Long) : MatriculaDto
+  reactivar(\n   idEstudiante : UUID,\n   idCursoPeriodo : UUID,\n   idMateria : Integer,\n   idPeriodoAcademico : Integer,\n   idProfesor : Long) : MatriculaDto
+  listarPorEstudiante(idEstudiante : UUID) : MatriculaDto [*] {ordered, nonunique}
+  listarPorCursoPeriodo(idCursoPeriodo : UUID) : MatriculaDto [*] {ordered, nonunique}
+  buscarEstudiante(idEstudiante : UUID) : EstudianteDto
+  buscarCursoPeriodo(idCursoPeriodo : UUID) : CursoPeriodoDto
+  buscarMateria(idMateria : Integer) : MateriaDto
+  buscarProfesor(idProfesor : Long) : ProfesorDto
}

note bottom of MatriculaControlador
  Entrada: MatriculaCrearDto (cinco IDs).
  Salida: MatriculaDto.
  Inyecta ademas EstudianteServicio, CursoPeriodoServicio,
  MateriaServicio y ProfesorServicio para consultas de apoyo.
end note

class "MatriculaServicio" as MatriculaServicio {
-  matriculaRepositorio : MatriculaRepositorio {readOnly}
-  estudianteRepositorio : EstudianteRepositorio {readOnly}
-  cursoPeriodoRepositorio : CursoPeriodoRepositorio {readOnly}
-  materiaRepositorio : MateriaRepositorio {readOnly}
-  periodoAcademicoRepositorio : PeriodoAcademicoRepositorio {readOnly}
-  profesorRepositorio : ProfesorRepositorio {readOnly}
-  mapeador : MatriculaMapeador {readOnly}
--
+  <<create>> MatriculaServicio(\n   matriculaRepositorio : MatriculaRepositorio,\n   estudianteRepositorio : EstudianteRepositorio,\n   cursoPeriodoRepositorio : CursoPeriodoRepositorio,\n   materiaRepositorio : MateriaRepositorio,\n   periodoAcademicoRepositorio : PeriodoAcademicoRepositorio,\n   profesorRepositorio : ProfesorRepositorio,\n   mapeador : MatriculaMapeador)
+  matricular(dto : MatriculaCrearDto) : MatriculaDto
+  retirar(\n   idEstudiante : UUID,\n   idCursoPeriodo : UUID,\n   idMateria : Integer,\n   idPeriodoAcademico : Integer,\n   idProfesor : Long) : MatriculaDto
+  reactivar(\n   idEstudiante : UUID,\n   idCursoPeriodo : UUID,\n   idMateria : Integer,\n   idPeriodoAcademico : Integer,\n   idProfesor : Long) : MatriculaDto
+  listarPorEstudiante(idEstudiante : UUID) : MatriculaDto [*] {ordered, nonunique}
+  listarPorCursoPeriodo(idCursoPeriodo : UUID) : MatriculaDto [*] {ordered, nonunique}
-  buscarDependencias(\n   idEstudiante : UUID,\n   idCursoPeriodo : UUID,\n   idMateria : Integer,\n   idPeriodoAcademico : Integer,\n   idProfesor : Long) : DependenciasMatricula
-  buscarMatricula(dependencias : DependenciasMatricula) : Matricula
-  validarCursoPeriodo(cursoPeriodo : CursoPeriodo,\n   materia : Materia, periodoAcademico : PeriodoAcademico) : void
-  hidratarYmapearUnico(\n   matricula : Matricula,\n   estudiante : Estudiante,\n   cursoPeriodo : CursoPeriodo,\n   materia : Materia,\n   periodoAcademico : PeriodoAcademico,\n   profesor : Profesor) : MatriculaDto
}

note bottom of MatriculaServicio
  Valida que CursoPeriodo corresponda a la Materia y al
  PeriodoAcademico antes de construir la PK.
  private record DependenciasMatricula(Estudiante,
  CursoPeriodo, Materia, PeriodoAcademico, Profesor).

  Repositorios inyectados: MatriculaRepositorio,
  EstudianteRepositorio, CursoPeriodoRepositorio,
  MateriaRepositorio, PeriodoAcademicoRepositorio y
  ProfesorRepositorio.

  En la hidratacion crea los cinco cargadores:
  EstudianteCargador, CursoPeriodoCargador,
  MateriaCargador, PeriodoAcademicoCargador y
  ProfesorCargador.
  Los metodos de hidratacion de listas estan completos
  en el UML canonico.
end note

' ============================================================================
' Mapeo y persistencia principal
' ============================================================================
class "MatriculaMapeador" as MatriculaMapeador {
-  estudianteMapeador : EstudianteMapeador {readOnly}
-  cursoPeriodoMapeador : CursoPeriodoMapeador {readOnly}
-  materiaMapeador : MateriaMapeador {readOnly}
-  periodoAcademicoMapeador : PeriodoAcademicoMapeador {readOnly}
-  profesorMapeador : ProfesorMapeador {readOnly}
--
+  <<create>> MatriculaMapeador(\n   estudianteMapeador : EstudianteMapeador,\n   cursoPeriodoMapeador : CursoPeriodoMapeador,\n   materiaMapeador : MateriaMapeador,\n   periodoAcademicoMapeador : PeriodoAcademicoMapeador,\n   profesorMapeador : ProfesorMapeador)
+  toDtoList(\n   entidades : Matricula [*] {ordered, nonunique},\n   estudianteCargador : EstudianteCargador,\n   cursoPeriodoCargador : CursoPeriodoCargador,\n   materiaCargador : MateriaCargador,\n   periodoCargador : PeriodoAcademicoCargador,\n   profesorCargador : ProfesorCargador) : MatriculaDto [*] {ordered, nonunique}
-  validarIntegridad(\n   miEntidad : Matricula,\n   estudianteCargador : EstudianteCargador,\n   cursoPeriodoCargador : CursoPeriodoCargador,\n   materiaCargador : MateriaCargador,\n   periodoCargador : PeriodoAcademicoCargador,\n   profesorCargador : ProfesorCargador) : boolean
-  transformarDto(\n   miEntidad : Matricula,\n   estudianteCargador : EstudianteCargador,\n   cursoPeriodoCargador : CursoPeriodoCargador,\n   materiaCargador : MateriaCargador,\n   periodoCargador : PeriodoAcademicoCargador,\n   profesorCargador : ProfesorCargador) : MatriculaDto
+  toDto(\n   entidad : Matricula,\n   estudianteCargador : EstudianteCargador,\n   cursoPeriodoCargador : CursoPeriodoCargador,\n   materiaCargador : MateriaCargador,\n   periodoCargador : PeriodoAcademicoCargador,\n   profesorCargador : ProfesorCargador) : MatriculaDto
}

note bottom of MatriculaMapeador
  Delega en los cinco mapeadores de apoyo:
  EstudianteMapeador, CursoPeriodoMapeador,
  MateriaMapeador, PeriodoAcademicoMapeador y
  ProfesorMapeador.
  Recibe los cinco cargadores como parametros y
  valida la integridad antes de transformar.
end note

interface "RepositorioBase<T, ID>" as RepositorioBase <<interface>> {
+  {abstract} guardar(entidad : T) : T
+  {abstract} actualizar(entidad : T) : T
+  {abstract} buscarPorId(id : ID) : T [0..1]
+  {abstract} eliminar(id : ID) : boolean
+  {abstract} listarTodos() : T [*] {ordered, nonunique}
+  {abstract} contar() : long
+  {abstract} cerrar() : void
}

interface "MatriculaRepositorio" as MatriculaRepositorio <<interface>> {
+  {abstract} insertarSiNoExiste(matricula : Matricula) : boolean
+  {abstract} listarPorEstudiante(idEstudiante : UUID) : Matricula [*] {ordered, nonunique}
+  {abstract} listarPorCursoPeriodo(idCursoPeriodo : UUID) : Matricula [*] {ordered, nonunique}
}

abstract class "RepositorioBaseAbstracto {abstract}" as RepositorioBaseAbstracto #FDEBD0 {
#  tpaRepository : TpaRepository<T, ID> {readOnly}
--
+  <<create>> RepositorioBaseAbstracto(tpaRepository : TpaRepository<T, ID>)
+  guardar(entidad : T) : T
+  actualizar(entidad : T) : T
+  buscarPorId(id : ID) : T [0..1]
+  listarTodos() : T [*] {ordered, nonunique}
+  contar() : long
+  eliminar(id : ID) : boolean
+  cerrar() : void
}

class "MatriculaRepositorioImpl" as MatriculaRepositorioImpl {
+  <<create>> MatriculaRepositorioImpl(tpaRepository : TpaRepository<Matricula, MatriculaPk>)
+  insertarSiNoExiste(matricula : Matricula) : boolean
+  listarPorEstudiante(idEstudiante : UUID) : Matricula [*] {ordered, nonunique}
+  listarPorCursoPeriodo(idCursoPeriodo : UUID) : Matricula [*] {ordered, nonunique}
}

note bottom of MatriculaRepositorio
  Implementacion: MatriculaRepositorioImpl.
  Repositorios de apoyo inyectados en el servicio:
  EstudianteRepositorio, CursoPeriodoRepositorio,
  MateriaRepositorio, PeriodoAcademicoRepositorio y
  ProfesorRepositorio. Todos extienden RepositorioBase.
end note

' ============================================================================
' DTOs
' ============================================================================
class "MatriculaDto" as MatriculaDto <<record>> {
+  estudiante : EstudianteDto {readOnly}
+  cursoPeriodo : CursoPeriodoDto {readOnly}
+  materia : MateriaDto {readOnly}
+  periodoAcademico : PeriodoAcademicoDto {readOnly}
+  profesor : ProfesorDto {readOnly}
+  fechaMatricula : OffsetDateTime {readOnly}
+  estadoMatricula : EstadoEntidad {readOnly}
}

class "MatriculaCrearDto" as MatriculaCrearDto <<record>> {
+  idEstudiante : UUID {readOnly}
+  idCursoPeriodo : UUID {readOnly}
+  idMateria : Integer {readOnly}
+  idPeriodoAcademico : Integer {readOnly}
+  idProfesor : Long {readOnly}
}

note bottom of MatriculaDto
  Salida: EstudianteDto, CursoPeriodoDto, MateriaDto,
  PeriodoAcademicoDto y ProfesorDto + fechaMatricula
  + estadoMatricula.
  Entrada: MatriculaCrearDto con los cinco IDs de la PK.
end note

' ============================================================================
' Modelo
' ============================================================================
class "Matricula" as Matricula {
-  idMatricula : MatriculaPk
-  fechaMatricula : OffsetDateTime
-  estadoMatricula : EstadoEntidad
--
#  <<create>> Matricula()
+  <<create>> Matricula(idMatricula : MatriculaPk)
+  <<create>> Matricula(\n   idMatricula : MatriculaPk,\n   fechaMatricula : OffsetDateTime,\n   estadoMatricula : EstadoEntidad)
+  retirar() : void
+  reactivar() : void
+  estaActiva() : boolean
+  getIdMatricula() : MatriculaPk
+  getFechaMatricula() : OffsetDateTime
+  getEstadoMatricula() : EstadoEntidad
+  getIdEstudiante() : UUID
+  getIdCursoPeriodo() : UUID
+  getIdMateria() : Integer
+  getIdPeriodoAcademico() : Integer
+  getIdProfesor() : Long
}

class "MatriculaPk" as MatriculaPk {
-  estudiante : Estudiante {readOnly}
-  cursoPeriodo : CursoPeriodo {readOnly}
-  materia : Materia {readOnly}
-  periodoAcademico : PeriodoAcademico {readOnly}
-  profesor : Profesor {readOnly}
--
#  <<create>> MatriculaPk()
+  <<create>> MatriculaPk(\n   estudiante : Estudiante,\n   cursoPeriodo : CursoPeriodo,\n   materia : Materia,\n   periodoAcademico : PeriodoAcademico,\n   profesor : Profesor)
+  getEstudiante() : Estudiante
+  getCursoPeriodo() : CursoPeriodo
+  getMateria() : Materia
+  getPeriodoAcademico() : PeriodoAcademico
+  getProfesor() : Profesor
+  getIdEstudiante() : UUID
+  getIdCursoPeriodo() : UUID
+  getIdMateria() : Integer
+  getIdPeriodoAcademico() : Integer
+  getIdProfesor() : Long
+  hashCode() : int
+  equals(obj : Object) : boolean
+  toString() : String
}

note bottom of MatriculaPk
  La PK relaciona cinco modelos en este orden:
  Estudiante, CursoPeriodo, Materia,
  PeriodoAcademico y Profesor.
  El orden no debe alterarse (TPA Blaster).
end note

enum "EstadoEntidad" as EstadoEntidad <<enumeration>> {
ACTIVO
INACTIVO
--
-  code : int {readOnly}
-  description : String {readOnly}
--
-  <<create>> EstadoEntidad(code : int, description : String)
+  getCode() : int
+  getDescription() : String
+  cambiarEstadoA(nuevoEstado : EstadoEntidad) : EstadoEntidad
}

class "Estudiante" as Estudiante <<resumen>> {
-  idEstudiante : UUID
--
+  getIdEstudiante() : UUID
}

class "CursoPeriodo" as CursoPeriodo <<resumen>> {
-  idCursoPeriodo : UUID
-  materia : Materia
-  periodoAcademico : PeriodoAcademico
--
+  getIdCursoPeriodo() : UUID
+  getIdMateria() : Integer
+  getIdPeriodoAcademico() : Integer
}

class "Materia" as Materia <<resumen>> {
-  idMateria : Integer
--
+  getIdMateria() : Integer
}

class "PeriodoAcademico" as PeriodoAcademico <<resumen>> {
-  idPeriodoAcademico : Integer
--
+  getIdPeriodoAcademico() : Integer
}

class "Profesor" as Profesor <<resumen>> {
-  idProfesor : Long
--
+  getIdProfesor() : Long
}

' ============================================================================
' Configuracion del modulo
' ============================================================================
interface "ModuloConfigurable" as ModuloConfigurable <<interface>> {
+  {abstract} cerrarRecursos() : void
}

class "ConfiguracionModuloMatricula" as ConfiguracionModuloMatricula {
-  matriculaRepositorio : MatriculaRepositorio {readOnly}
-  estudianteRepositorio : EstudianteRepositorio {readOnly}
-  estudianteServicio : EstudianteServicio {readOnly}
-  cursoPeriodoRepositorio : CursoPeriodoRepositorio {readOnly}
-  cursoPeriodoServicio : CursoPeriodoServicio {readOnly}
-  materiaRepositorio : MateriaRepositorio {readOnly}
-  materiaServicio : MateriaServicio {readOnly}
-  periodoAcademicoRepositorio : PeriodoAcademicoRepositorio {readOnly}
-  profesorRepositorio : ProfesorRepositorio {readOnly}
-  profesorServicio : ProfesorServicio {readOnly}
--
+  <<create>> ConfiguracionModuloMatricula(\n   estudianteRepositorio : EstudianteRepositorio,\n   estudianteServicio : EstudianteServicio,\n   cursoPeriodoRepositorio : CursoPeriodoRepositorio,\n   cursoPeriodoServicio : CursoPeriodoServicio,\n   materiaRepositorio : MateriaRepositorio,\n   materiaServicio : MateriaServicio,\n   periodoAcademicoRepositorio : PeriodoAcademicoRepositorio,\n   profesorRepositorio : ProfesorRepositorio,\n   profesorServicio : ProfesorServicio)
+  construirControlador() : MatriculaControlador
+  cerrarRecursos() : void
}

note bottom of ConfiguracionModuloMatricula
  Ensambla repositorios, mapeadores, servicio y controlador.
  ModuloConfigurable solo declara cerrarRecursos().
end note

' ============================================================================
' Relaciones
' ============================================================================
ManejadorWeb <|-- MatriculaWeb
MatriculaWeb --> "controlador\n1" MatriculaControlador
MatriculaControlador --> "matriculaServicio\n1" MatriculaServicio
MatriculaControlador ..> "entrada\n1" MatriculaCrearDto

MatriculaServicio --> "mapeador\n1" MatriculaMapeador
MatriculaServicio --> "matriculaRepositorio\n1" MatriculaRepositorio

MatriculaMapeador --> "produce\n1" MatriculaDto
MatriculaRepositorio --> "entrega / actualiza\n1" Matricula

Matricula --> "idMatricula\n1" MatriculaPk
Matricula --> "estadoMatricula\n1" EstadoEntidad
MatriculaPk --> "estudiante\n1" Estudiante
MatriculaPk --> "cursoPeriodo\n1" CursoPeriodo
MatriculaPk --> "materia\n1" Materia
MatriculaPk --> "periodoAcademico\n1" PeriodoAcademico
MatriculaPk --> "profesor\n1" Profesor

MatriculaDto --> "estadoMatricula\n1" EstadoEntidad

RepositorioBase <|-- MatriculaRepositorio
RepositorioBase <|.. RepositorioBaseAbstracto : <T -> T, ID -> ID>
RepositorioBaseAbstracto <|-- MatriculaRepositorioImpl
MatriculaRepositorio <|.. MatriculaRepositorioImpl

ModuloConfigurable <|.. ConfiguracionModuloMatricula
ConfiguracionModuloMatricula "1" *--> "matriculaRepositorio\n1" MatriculaRepositorio
ConfiguracionModuloMatricula ..> "construye\n1" MatriculaControlador

@enduml
